      "23": {
        "type": "data",
        "title": "Host health",
        "query": "timeseries { cpu = avg(dt.host.cpu.usage), mem = avg(dt.host.memory.usage), disk = max(dt.host.disk.used.percent) }, by: {dt.entity.host}\n| fields Host = entityName(dt.entity.host), `CPU %` = arrayAvg(cpu), `Memory %` = arrayAvg(mem), `Fullest disk %` = arrayMax(disk)\n| sort `CPU %` desc",
        "visualization": "table",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "coloring": {
            "colorRules": [
