{
  "name": "[RHA] Sean is Happy",
  "type": "dashboard",
  "content": {
    "version": 15,
    "variables": [],
    "tiles": {
      "0": {
        "type": "markdown",
        "content": "## 🖼️ Sean is Happy — banner image\n_Image placeholder: the banner image goes here once it is hosted at an https URL._"
      },
      "1": {
        "type": "markdown",
        "content": "# 💙 Sean is Happy\nService response time, infrastructure health and monitoring configuration for **rha75589**. Tiles turn **blue** when healthy, **amber/red** when a threshold is crossed. Source: `dashboards/sean-is-happy/` in the Isatec-RHA-SaaS repo."
      },
      "2": {
        "type": "markdown",
        "content": "## ⚡ Service performance"
      },
      "3": {
        "type": "data",
        "title": "Avg response time",
        "query": "timeseries rt = avg(dt.service.request.response_time)\n| fieldsAdd rt = rt[] / 1000\n| fieldsAdd `Avg response time` = arrayAvg(rt)",
        "visualization": "singleValue",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "singleValue": {
            "labelMode": "none",
            "label": "Avg response time",
            "recordField": "Avg response time",
            "colorThresholdTarget": "background",
            "trend": {
              "isVisible": true
            },
            "sparklineSettings": {
              "record": "rt",
              "variant": "area"
            },
            "isIconVisible": true,
            "prefixIcon": "ResponseTimeIcon"
          },
          "coloring": {
            "colorRules": [
              {
                "colorMode": "custom-color",
                "comparator": "<",
                "customColor": "#134FC9",
                "field": "Avg response time",
                "type": "number",
                "value": 500
              },
              {
                "colorMode": "custom-color",
                "comparator": "≥",
                "customColor": "#C4233B",
                "field": "Avg response time",
                "type": "number",
                "value": 500
              }
            ]
          },
          "unitsOverrides": [
            {
              "identifier": "Avg response time",
              "unitCategory": "unspecified",
              "baseUnit": "count",
              "displayUnit": null,
              "decimals": 1,
              "suffix": " ms",
              "delimiter": true
            }
          ]
        },
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 1,
          "maxResultRecords": 1000
        },
        "davis": {
          "enabled": false,
          "davisVisualization": {
            "isAvailable": true
          }
        }
      },
      "4": {
        "type": "data",
        "title": "P90 response time",
